# Copy to .env.local. Public Sanity IDs are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Local: http://localhost:3000. Production: your real https domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Search Console HTML verification token (not the whole meta tag):
GOOGLE_SITE_VERIFICATION=
# Set true on your final production deployment only. Leave false on previews.
SITE_INDEXABLE=false

# auto: samples before Sanity connection; demo: samples always; sanity: real CMS products only.
PRODUCT_SOURCE=auto
