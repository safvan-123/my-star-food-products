# Copy to .env.local. Public Sanity IDs are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=tmnhiibx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Local: http://localhost:3000. Production: your real https domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Search Console HTML verification token (not the whole meta tag):
GOOGLE_SITE_VERIFICATION=
# Set true on your final production deployment only. Leave false on previews.
SITE_INDEXABLE=false

# Optional for a private dataset only. Use a read-only token on the server.
SANITY_API_READ_TOKEN=
# sanity: published CMS products only; demo: local preview; auto: samples before Sanity connection.
PRODUCT_SOURCE=sanity
